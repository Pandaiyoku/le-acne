rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized() {
      return request.auth != null &&
        request.auth.uid == 'Qwc1ZM4xDNagGcZrhhdBDQ1FUzj1';
    }

    match /private/{document=**} {
      allow read, write: if authorized();
    }
  }
}
