rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authorized() {
      return request.auth != null &&
        request.auth.token.email != null &&
        request.auth.token.email == request.auth.token.email &&
        request.auth.token.email == 'REPLACE_WITH_YOUR_ALLOWED_EMAIL';
    }
    // Deploy after replacing the literal above with the same value as your env var.
    match /private/{document=**} { allow read, write: if authorized(); }
  }
}
